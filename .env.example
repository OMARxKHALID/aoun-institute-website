# Copy to .env.local and fill in. Never commit .env.local.

# MongoDB Atlas connection string (database name in the path)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/aoun-institute

# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google login (optional; button hidden until both are set)
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (optional in dev; emails print to the server console without it)
RESEND_API_KEY=
EMAIL_FROM=Aoun Institute <noreply@yourdomain.com>

# Cloudinary (run `bun run cloudinary:presets` once after filling these)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mux video (uploads disabled until token id + secret are set)
# Access token: Settings > Access Tokens (Mux Video read + write)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Signing key: Settings > Signing Keys (ID + base64 private key)
MUX_SIGNING_KEY=
MUX_PRIVATE_KEY=
# Webhook: Settings > Webhooks, URL https://yourdomain.com/api/webhooks/mux
MUX_WEBHOOK_SECRET=
# DRM configuration id (after Mux enables DRM on your account). Without it uploads use signed playback only.
MUX_DRM_CONFIGURATION_ID=
# Optional playback restriction (allowed domains) id
MUX_PLAYBACK_RESTRICTION_ID=

# Seed accounts for local development only (`bun run seed`). Change the admin password before going live.
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=adminadmin
SEED_STUDENT_EMAIL=test@gmail.com
SEED_STUDENT_PASSWORD=testtest
# Password for the *@demo.pk students created by `bun run demo`
DEMO_STUDENT_PASSWORD=demo1234
